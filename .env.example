# Nothing here is required. D1 (DB) and R2 (FILES) come from wrangler.jsonc bindings.
# Never commit real values: .env*, .env.deploy and .dev.vars are git-ignored.

# Optional: short folder for local database files (Windows 260-character path limit).
LOCAL_STATE_DIR=

# .env.deploy (separate, git-ignored file) holds the admin Worker's name and
# the Supabase project used for admin sign-in:
# ADMIN_WORKER_NAME=<hard-to-guess-name>
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable key>

# To run the admin locally, put these in .dev.vars (git-ignored), not here:
# APP_ROLE=admin
# ADMIN_EMAILS=you@example.com
# TOTP_ENCRYPTION_KEY=<32 random bytes, base64>
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable key>
# STORE_URL=http://localhost:8787
# SITE_URL=https://your-domain.example   (optional, store or admin)
