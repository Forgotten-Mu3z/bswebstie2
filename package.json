{
  "name": "bs-gaming-store",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app components lib server db proxy.ts",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "deploy": "vinext build && node scripts/deploy.mjs",
    "deploy:no-r2": "vinext build && node scripts/deploy.mjs --no-r2",
    "photos:clean": "node scripts/remove-photo-backgrounds.mjs",
    "media:record": "node scripts/media-record.mjs",
    "brand:assets": "node scripts/make-brand-assets.mjs",
    "instagram:products": "node scripts/import-instagram-products.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "uqr": "0.1.3",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
